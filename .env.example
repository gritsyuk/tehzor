# Скопируйте в .env (файл в .gitignore). Ключ никогда не коммитится.
TEHZOR_API_KEY=00000000-0000-0000-0000-000000000000
# Необязательно:
# TEHZOR_USER_ID=
# TEHZOR_BASE_URL=https://api.tehzor.ru

# Seeds для контрактных тестов (pytest -m contract), только чтение:
# TEHZOR_SEED_OBJECT_ID=<uuid объекта>,<uuid объекта со всеми стадиями>
# TEHZOR_SEED_SPACE_ID=<id помещения с приборами учёта>
